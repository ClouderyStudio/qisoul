# 复制为 .env 并按部署环境填写
# 前端直连的后端 API 地址（生产环境请配置为你的后端域名）
VITE_API_BASE_URL=https://localhost:7288
# Casdoor 单点登录服务地址
VITE_CASDOOR_SERVER_URL=https://your-casdoor-domain.com
# Casdoor 应用 client_id（OAuth 公开标识，非机密）
VITE_CASDOOR_CLIENT_ID=your-client-id
# Casdoor 组织与应用名
VITE_CASDOOR_ORG_NAME=your-org-name
VITE_CASDOOR_APP_NAME=your-app-name